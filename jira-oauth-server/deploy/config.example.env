# Copy to config.local.env and replace these non-secret values.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east1
CLOUD_RUN_SERVICE=jira-oauth-exchange
RUNTIME_SERVICE_ACCOUNT=jira-oauth-runtime
CHROME_EXTENSION_ID=your_chrome_extension_id
JIRA_CLIENT_ID=jira-oauth-client-id
JIRA_CLIENT_SECRET=jira-oauth-client-secret
